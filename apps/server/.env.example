# Accomplice game server. Copy to apps/server/.env (gitignored) and fill in what you need.
# Everything is optional: with nothing set, the game runs offline with canned suspect replies and captions only.

# --- HTTP ---
PORT=8787
HOST=0.0.0.0
# Public origin phones should use (QR code / join link). Default: http://<LAN IP>:<PORT>
# PUBLIC_URL=https://accomplice.example

# --- Suspect brains ---
# anthropic | bedrock | mock. Default: anthropic if ANTHROPIC_API_KEY is set, else mock.
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# Model for in-character replies, and a smaller one for the claim-extraction check.
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# Background model re-check of every finished reply, logged to audit.jsonl (never blocks playback): on | off
# SECOND_PASS_AUDIT=on
# Bedrock (uses the normal AWS credential chain)
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- AWS (Polly voices, Transcribe speech input, Translate) ---
# Uses the standard AWS credential chain (env vars, ~/.aws, SSO, instance role).
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
# polly | none (captions only)
TTS_PROVIDER=polly
# Narrator voice for every announcement. Suspect voices come from the case.
# Narrator voice: polly (NARRATOR_VOICE is a Polly voice id) or elevenlabs (all narrator lines are cached on disk).
NARRATOR_PROVIDER=polly
NARRATOR_VOICE=Brian
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Voice of the butler or housekeeper who takes the practice question.
# HOUSE_VOICE=Arthur
# transcribe | none. Streaming speech input at /stt.
STT_PROVIDER=transcribe
# Max parallel Polly requests (bursts get throttled).
# POLLY_CONCURRENCY=8
# Suspect voices are on the critical path: neural in a nearby region (ap-south-1: ~0.6 s per line).
# POLLY_REGION=ap-south-1
# POLLY_ENGINE=neural
# Narrator lines are pre-rendered while the lobby fills, so they use the best (generative) voices.
# NARRATOR_POLLY_REGION=us-east-1
# NARRATOR_POLLY_ENGINE=generative
# on | off. Per-player Hindi captions, clues and questions via Amazon Translate.
TRANSLATE=on

# --- Game ---
# auto (real @accomplice/fairplay if present, else the built-in stub) | fairplay | stub
ENGINE=auto
MIN_PLAYERS=1
MAX_PLAYERS=6
QUESTIONS_PER_ROUND=2
DIFFICULTY=2
# Cold open with one free practice question before round one: on | off
TUTORIAL=on
# Soft on-screen timer per round and for voting (never ends a phase by itself; phone:moreTime adds MORE_TIME_SECONDS). 0 = off.
ROUND_SECONDS=240
MORE_TIME_SECONDS=60
# How long the question queue waits for a line to finish playing, as a multiple of its audio length.
# The TV can end the wait early with {t:'tv:spoken', id}. 0 = never wait (tests, simulation).
SPEECH_WAIT=1

# --- Files and logs ---
# Audio cache and the fair play audit log (audit.jsonl) live here.
# CACHE_DIR=apps/server/.cache
# LOG_LEVEL=info
